{
  "name": "qokhims",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "เว็บไซต์ร้านรับออกแบบงานกราฟิกและจำหน่ายฟอนต์ qokhims (Cloudflare Workers + D1 + R2 + React)",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev --port 8787",
    "build": "vite build",
    "preview": "npm run build && wrangler dev --port 8787",
    "db:migrate:local": "wrangler d1 migrations apply pakzy-o-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply pakzy-o-db --remote",
    "admin:create:local": "node scripts/create-admin.mjs --local",
    "admin:create:remote": "node scripts/create-admin.mjs --remote",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "hono": "^4.7.2",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.2.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261113.1",
    "@tailwindcss/vite": "^4.0.8",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.8",
    "typescript": "^5.7.3",
    "vite": "^6.1.1",
    "vitest": "^5.1.0",
    "wrangler": "^4.0.0"
  }
}
